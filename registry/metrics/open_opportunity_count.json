{
  "id": "open_opportunity_count",
  "version": 1,
  "name": "Open opportunity count",
  "description": "Number of opportunities that are not yet closed.",
  "owner": "Customer Analytics (metric steward)",
  "unit": "count",
  "synonyms": [
    "open opportunity count",
    "open opportunities",
    "number of open deals",
    "how many open deals",
    "open deal count",
    "deal count",
    "count of opportunities",
    "how many opportunities"
  ],
  "kind": "aggregate",
  "source": {
    "table": "opportunities",
    "measure": {
      "fn": "count"
    },
    "conditions": [
      {
        "column": "is_closed",
        "equals": false
      }
    ],
    "periodColumn": "close_date"
  },
  "dimensions": [
    "region",
    "stage",
    "owner"
  ],
  "notes": "Grouped by stage, this is the deal count by stage view."
}
