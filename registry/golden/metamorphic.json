{
  "version": 1,
  "asOfDate": "2026-10-08",
  "about": "Metamorphic cases for the three governed metrics (report Issue 5). Human-reviewed expectations, phrased differently from phrases.json. equivalent: every phrase means the same request, so it must give the same intent and, under the same person and snapshot, the same result. contrasts: one change of meaning must change the named field, never silently keep the old meaning. clarify: underspecified or unrepresentable questions must ask. followUps: context carried or reset per the glossary follow_up rule. safeGaps: paraphrases the deterministic model doesn't read yet; they may answer correctly, ask or decline, but must never become a different request.",
  "equivalent": [
    {
      "name": "open pipeline, whole scope",
      "intent": { "metric": "open_pipeline", "filters": {}, "groupBy": [] },
      "phrases": ["how much money is in our open pipeline", "what's the open pipeline worth", "sum of open pipeline", "whats our pipeline lookin like", "how much pipeline do we have", "open pipeline value"]
    },
    {
      "name": "open opportunity count, whole scope",
      "intent": { "metric": "open_opportunity_count", "filters": {}, "groupBy": [] },
      "phrases": ["number of open opportunities", "count our open opportunities", "how many open deals do we have", "how many open deals are in the pipeline", "open opportunity count"]
    },
    {
      "name": "coverage this quarter",
      "intent": { "metric": "pipeline_coverage", "filters": { "period": "FY27-Q1" }, "groupBy": [] },
      "phrases": ["pipeline coverage this quarter", "what is our coverage for this quarter", "pipeline to quota this quarter", "coverage ratio for FY27-Q1", "FY27-Q1 pipeline coverage", "pipeline vs quota this quarter"]
    },
    {
      "name": "coverage next quarter",
      "intent": { "metric": "pipeline_coverage", "filters": { "period": "FY27-Q2" }, "groupBy": [] },
      "phrases": ["pipeline coverage next quarter", "coverage for FY27-Q2", "next quarter's coverage"]
    },
    {
      "name": "open pipeline in the West",
      "intent": { "metric": "open_pipeline", "filters": { "regions": ["west"] }, "groupBy": [] },
      "phrases": ["open pipeline in the west", "west open pipeline", "open pipeline for west region", "West region open pipeline"]
    },
    {
      "name": "open pipeline in the East by stage",
      "intent": { "metric": "open_pipeline", "filters": { "regions": ["east"] }, "groupBy": ["stage"] },
      "phrases": ["open pipeline by stage in the east", "east open pipeline by stage"]
    }
  ],
  "contrasts": [
    {
      "change": "number of opportunities -> value of opportunities",
      "differsIn": "metric",
      "a": { "phrase": "number of open opportunities", "expect": { "metric": "open_opportunity_count", "filters": {}, "groupBy": [] } },
      "b": { "phrase": "total value of open opportunities", "expect": { "clarify": true } }
    },
    {
      "change": "number by region -> value by region",
      "differsIn": "metric",
      "a": { "phrase": "number of open opportunities by region", "expect": { "metric": "open_opportunity_count", "filters": {}, "groupBy": ["region"] } },
      "b": { "phrase": "value of open opportunities by region", "expect": { "clarify": true } }
    },
    {
      "change": "how many open deals -> how much open pipeline",
      "differsIn": "metric",
      "a": { "phrase": "how many open deals this quarter", "expect": { "metric": "open_opportunity_count", "filters": { "period": "FY27-Q1" }, "groupBy": [] } },
      "b": { "phrase": "how much open pipeline this quarter", "expect": { "metric": "open_pipeline", "filters": { "period": "FY27-Q1" }, "groupBy": [] } }
    },
    {
      "change": "open pipeline -> how many open pipeline deals",
      "differsIn": "metric",
      "a": { "phrase": "open pipeline this quarter", "expect": { "metric": "open_pipeline", "filters": { "period": "FY27-Q1" }, "groupBy": [] } },
      "b": { "phrase": "how many open pipeline deals this quarter", "expect": { "clarify": true } }
    },
    {
      "change": "open pipeline -> pipeline compared with quota",
      "differsIn": "metric",
      "a": { "phrase": "open pipeline this quarter", "expect": { "metric": "open_pipeline", "filters": { "period": "FY27-Q1" }, "groupBy": [] } },
      "b": { "phrase": "how does pipeline compare to quota this quarter", "expect": { "clarify": true } }
    },
    {
      "change": "coverage -> open pipeline",
      "differsIn": "metric",
      "a": { "phrase": "pipeline coverage this quarter", "expect": { "metric": "pipeline_coverage", "filters": { "period": "FY27-Q1" }, "groupBy": [] } },
      "b": { "phrase": "open pipeline this quarter", "expect": { "metric": "open_pipeline", "filters": { "period": "FY27-Q1" }, "groupBy": [] } }
    },
    {
      "change": "this quarter -> next quarter",
      "differsIn": "period",
      "a": { "phrase": "pipeline coverage this quarter", "expect": { "metric": "pipeline_coverage", "filters": { "period": "FY27-Q1" }, "groupBy": [] } },
      "b": { "phrase": "pipeline coverage next quarter", "expect": { "metric": "pipeline_coverage", "filters": { "period": "FY27-Q2" }, "groupBy": [] } }
    },
    {
      "change": "total -> by region",
      "differsIn": "groupBy",
      "a": { "phrase": "pipeline coverage this quarter", "expect": { "metric": "pipeline_coverage", "filters": { "period": "FY27-Q1" }, "groupBy": [] } },
      "b": { "phrase": "pipeline coverage this quarter by region", "expect": { "metric": "pipeline_coverage", "filters": { "period": "FY27-Q1" }, "groupBy": ["region"] } }
    },
    {
      "change": "West -> East",
      "differsIn": "regions",
      "a": { "phrase": "open pipeline in the west", "expect": { "metric": "open_pipeline", "filters": { "regions": ["west"] }, "groupBy": [] } },
      "b": { "phrase": "open pipeline in the east", "expect": { "metric": "open_pipeline", "filters": { "regions": ["east"] }, "groupBy": [] } }
    },
    {
      "change": "Prospecting -> Engaging",
      "differsIn": "stages",
      "a": { "phrase": "open pipeline in prospecting", "expect": { "metric": "open_pipeline", "filters": { "stages": ["Prospecting"] }, "groupBy": [] } },
      "b": { "phrase": "open pipeline in engaging", "expect": { "metric": "open_pipeline", "filters": { "stages": ["Engaging"] }, "groupBy": [] } }
    },
    {
      "change": "count this quarter -> count in the West",
      "differsIn": "filters",
      "a": { "phrase": "open opportunities this quarter", "expect": { "metric": "open_opportunity_count", "filters": { "period": "FY27-Q1" }, "groupBy": [] } },
      "b": { "phrase": "how many open opportunities in the west", "expect": { "metric": "open_opportunity_count", "filters": { "regions": ["west"] }, "groupBy": [] } }
    }
  ],
  "clarify": [
    { "phrase": "pipeline coverage", "why": "coverage needs a quarter" },
    { "phrase": "coverage", "why": "coverage needs a quarter" },
    { "phrase": "what is the pipeline for last quarter", "why": "only FY27-Q1 and FY27-Q2 have quota" },
    { "phrase": "open pipeline excluding west", "why": "exclusion can't be represented yet" },
    { "phrase": "open pipeline for Nimbus", "why": "unknown name; answering for everything would be a different question" },
    { "phrase": "weighted coverage this quarter", "why": "weighted coverage isn't a governed metric" },
    { "phrase": "closed won pipeline", "why": "open pipeline excludes won deals" },
    { "phrase": "Compare open pipeline with open opportunity count by region.", "why": "two governed metrics named; answering one would drop the other (PR #51 review)" },
    { "phrase": "Show pipeline coverage and open pipeline for this quarter.", "why": "two governed metrics named; one is answered at a time" },
    { "phrase": "open deal count and pipeline value", "why": "two governed metrics named; the longer synonym must not win" }
  ],
  "followUps": [
    {
      "previous": { "metric": "pipeline_coverage", "filters": { "period": "FY27-Q1" }, "groupBy": [] },
      "phrase": "and next quarter?",
      "expect": { "metric": "pipeline_coverage", "filters": { "period": "FY27-Q2" }, "groupBy": [] }
    },
    {
      "previous": { "metric": "open_pipeline", "filters": {}, "groupBy": [] },
      "phrase": "what about West?",
      "expect": { "metric": "open_pipeline", "filters": { "regions": ["west"] }, "groupBy": [] }
    },
    {
      "previous": { "metric": "open_pipeline", "filters": { "regions": ["west"] }, "groupBy": [] },
      "phrase": "by stage",
      "expect": { "metric": "open_pipeline", "filters": { "regions": ["west"] }, "groupBy": ["stage"] }
    },
    {
      "previous": { "metric": "open_pipeline", "filters": { "regions": ["west"] }, "groupBy": [] },
      "phrase": "how many open deals",
      "expect": { "metric": "open_opportunity_count", "filters": {}, "groupBy": [] }
    },
    {
      "previous": { "metric": "open_opportunity_count", "filters": { "regions": ["east"] }, "groupBy": [] },
      "phrase": "what about this quarter?",
      "expect": { "metric": "open_opportunity_count", "filters": { "regions": ["east"], "period": "FY27-Q1" }, "groupBy": [] }
    }
  ],
  "safeGaps": [
    { "phrase": "how many deals are still open", "intended": { "metric": "open_opportunity_count", "filters": {}, "groupBy": [] } },
    { "phrase": "open opp count", "intended": { "metric": "open_opportunity_count", "filters": {}, "groupBy": [] } },
    { "phrase": "opportunities that are open, how many", "intended": { "metric": "open_opportunity_count", "filters": {}, "groupBy": [] } },
    { "phrase": "how many opportunities have we not closed yet", "intended": { "metric": "open_opportunity_count", "filters": {}, "groupBy": [] } },
    { "phrase": "value of open deals", "intended": { "metric": "open_pipeline", "filters": {}, "groupBy": [] } }
  ]
}
