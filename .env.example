# Leave the database URLs empty to use the embedded Postgres (PGlite). A production server (`npm start`)
# refuses PGlite unless ALLOW_EMBEDDED_DB=true (the laptop demo).
ALLOW_EMBEDDED_DB=
# For Postgres mode, run `docker compose up -d`, then `npm run db:setup` with MIGRATION_DATABASE_URL (the owner
# login). The running server needs only DATABASE_URL, AUDIT_DATABASE_URL and AUTH_DATABASE_URL; if
# MIGRATION_DATABASE_URL is also set, it runs the same setup at start (handy locally, not for a deployment).
MIGRATION_DATABASE_URL=
DATABASE_URL=
AUDIT_DATABASE_URL=
AUTH_DATABASE_URL=
# Example values for docker-compose.yml (local development only):
# MIGRATION_DATABASE_URL=postgres://copilot_owner:local_dev_only@127.0.0.1:5432/copilot
# DATABASE_URL=postgres://app_readonly:readonly_local_dev@127.0.0.1:5432/copilot
# AUDIT_DATABASE_URL=postgres://app_audit:audit_local_dev@127.0.0.1:5432/copilot
# AUTH_DATABASE_URL=postgres://app_auth:auth_local_dev@127.0.0.1:5432/copilot

# Local testing only. With nobody signed in, the "Viewing as" identity switch works only when this is true.
# Demo accounts (DEMO_INVITE_SECRET below) are the normal way in.
# `npm run dev` only: a production server (`npm start`) refuses to start with it on.
ALLOW_TEST_IDENTITIES=

# Demo sign-in. A long random value turns on sign-up with invite codes; `npm run invites` prints one code per demo
# person. Keep it out of the repository; at least 16 characters in production. Each code creates one account.
DEMO_INVITE_SECRET=
# Optional date after which invite codes stop working, for example 2026-11-10.
DEMO_INVITE_EXPIRES=

# HTTPS protections. In production (`npm start`) the session cookie is Secure and HSTS is sent unless set to
# "false" here. Both are read when the server starts, so they can be changed without a rebuild. Browsers ignore HSTS over plain http, and Chrome, Edge and Firefox accept Secure cookies on
# http://localhost; set COOKIE_SECURE=false only for a plain-http demo in another browser.
COOKIE_SECURE=
ENABLE_HSTS=

# Sign-in limits count attempts per address. Set this to the number of proxies in front of the app that append
# to X-Forwarded-For (1 for a single load balancer). Empty or 0 ignores that header, since a caller can write
# anything in it, and all callers share one limit of 100 attempts a minute.
TRUSTED_PROXY_HOPS=

# Security channel. A Slack incoming webhook (https://hooks.slack.com/services/...) that gets a message when a
# question is flagged as an attack or a session is locked: reason codes, who and the audit row id, never the
# question text. Leave empty to turn it off.
SECURITY_SLACK_WEBHOOK_URL=

# Key for the audit log's question fingerprints (HMAC-SHA-256). Set a long random value (`openssl rand -hex 32`) so
# fingerprints and the per-address sign-in limit stay comparable across restarts and processes; empty means a random key per process. Keep it out of the repository.
# Required (32+ characters) for a production server (`npm start`), which refuses to start without it.
AUDIT_HASH_KEY=

# Intent model. Leave empty for the deterministic golden-set model (no AI calls, used in CI).
# Set to "claude" to use Claude for question understanding; it then needs Anthropic credentials
# (ANTHROPIC_API_KEY or an `ant auth login` profile). The client allows any AI provider (Oct 15); run the golden
# set against Claude (`INTENT_MODEL=claude npm run eval:golden`) before using it in a demo.
INTENT_MODEL=
ANTHROPIC_API_KEY=

# Dataset folder (defaults to data/maven-crm). After confirming a second CRM folder with
# `npm run onboard:confirm -- --by "<your name>"`, set DATASET_DIR=data/northstar-crm to load it.
DATASET_DIR=

# Claude timeout before the deterministic model answers (milliseconds, 1000-60000; default 8000).
CLAUDE_TIMEOUT_MS=
# Retention for `npm run purge` (whole days, at least 1; default 90).
AUDIT_RETENTION_DAYS=
