# Leave the three database URLs empty to use the embedded Postgres (PGlite). A production server (`npm start`)
# refuses PGlite unless ALLOW_TEST_IDENTITIES=true (the laptop demo) or ALLOW_EMBEDDED_DB=true.
ALLOW_EMBEDDED_DB=
# For Postgres mode, run `docker compose up -d` and set all three:
MIGRATION_DATABASE_URL=
DATABASE_URL=
AUDIT_DATABASE_URL=
# Example values for docker-compose.yml (local development only):
# MIGRATION_DATABASE_URL=postgres://copilot_owner:local_dev_only@127.0.0.1:5432/copilot
# DATABASE_URL=postgres://app_readonly:readonly_local_dev@127.0.0.1:5432/copilot
# AUDIT_DATABASE_URL=postgres://app_audit:audit_local_dev@127.0.0.1:5432/copilot

# There is no sign-in yet. The "Viewing as" identity switch only works when this is true.
# Turn it on for local testing and demos; leave it off anywhere real users can reach the app.
ALLOW_TEST_IDENTITIES=

# Demo sign-in. A long random value turns on sign-up with invite codes; `npm run invites` prints one code per demo
# person. Keep it out of the repository. COOKIE_SECURE=true marks the session cookie Secure (needs HTTPS).
DEMO_INVITE_SECRET=
COOKIE_SECURE=

# Key for the audit log's question fingerprints (HMAC-SHA-256). Set a long random value so fingerprints stay
# comparable across restarts; empty means a random key per process. Keep it out of the repository.
AUDIT_HASH_KEY=

# Intent model. Leave empty for the deterministic golden-set model (no AI calls, used in CI).
# Set to "claude" to use Claude for question understanding; it then needs Anthropic credentials
# (ANTHROPIC_API_KEY or an `ant auth login` profile). The client allows any AI provider (Oct 15); run the golden
# set against Claude (`INTENT_MODEL=claude npm run eval:golden`) before using it in a demo.
INTENT_MODEL=
ANTHROPIC_API_KEY=

# Dataset folder (defaults to data/maven-crm). After confirming a second CRM folder with
# `npm run onboard:confirm -- --by "<your name>"`, set DATASET_DIR=data/northstar-crm to load it.
DATASET_DIR=

