{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/node_modules",
      "!drizzle/meta",
      "!alerts/drizzle/meta",
      "!data",
      "!**/*.json",
      "!**/*.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "off",
        "noFocusedTests": "error",
        // Off on purpose: the only skips are describe.skipIf around the Postgres suites, which run when DATABASE_URL is set
        // (CI). An it.skip or describe.skip is a review check (standards section 7), not something this rule catches.
        "noSkippedTests": "off"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "complexity": {
        "useOptionalChain": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": {
            "maxLines": 60,
            "skipBlankLines": true
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "warn",
        "noMisusedPromises": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "app/**",
        "src/**",
        "alerts/app/**",
        "alerts/src/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": {
              "level": "error",
              "options": {
                "allow": [
                  "error",
                  "warn",
                  "info"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
