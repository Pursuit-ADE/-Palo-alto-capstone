{
  "name": "governed-analytics-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "Governed AI analytics copilot and private alerts. Team ALTO PALS capstone for Palo Alto Networks Customer Analytics.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "eval:golden": "tsx --env-file-if-exists=.env.local scripts/eval-golden.ts",
    "eval:redteam": "tsx --env-file-if-exists=.env.local scripts/eval-redteam.ts",
    "invites": "tsx --env-file-if-exists=.env.local scripts/invites.ts",
    "accounts": "tsx scripts/accounts.ts",
    "docs:dictionary": "tsx scripts/data-dictionary.ts",
    "onboard:profile": "tsx scripts/onboard-dataset.ts profile",
    "onboard:propose": "tsx scripts/onboard-dataset.ts propose",
    "onboard:confirm": "tsx scripts/onboard-dataset.ts confirm",
    "db:setup": "tsx scripts/db-setup.ts",
    "purge": "tsx scripts/purge.ts",
    "trends": "tsx scripts/question-trends.ts",
    "trends:agent": "tsx --env-file-if-exists=.env.local scripts/trends-agent.ts",
    "agent:ask": "tsx --env-file-if-exists=.env.local scripts/agent-ask.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@electric-sql/pglite": "0.5.15",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "type": "module"
}
