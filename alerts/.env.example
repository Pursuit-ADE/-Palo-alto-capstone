# Database. Leave both empty for the embedded, in-memory database (state resets on restart).
# For a persistent database, run `docker compose up -d` in the repo root and set both:
MIGRATION_DATABASE_URL=
ALERTS_DATABASE_URL=
# Example values for ../docker-compose.yml (local development only):
# MIGRATION_DATABASE_URL=postgres://copilot_owner:local_dev_only@127.0.0.1:5432/alerts
# ALERTS_DATABASE_URL=postgres://alerts_app:alerts_local_dev@127.0.0.1:5432/alerts

# Scheduler. Off: one evaluation as of the demo time. On: a tick every ALERTS_TICK_SECONDS with the real clock.
ALERTS_SCHEDULER=
ALERTS_TICK_SECONDS=60
# Each tick looks this far back again for events imported late (deduplicated). Default 72.
ALERTS_LATE_WINDOW_HOURS=72
# Set to false to start with no subscriptions (people add their own on the page).
ALERTS_SEED_DEMO_SUBSCRIPTIONS=

# Base URL of the copilot, for "Ask the copilot" links.
COPILOT_URL=http://localhost:3000
# JSON map of user id -> that user's own Slack incoming webhook. Never commit real values.
SLACK_USER_WEBHOOKS=

# There is no sign-in yet. The "Viewing as" identity switch only works when this is exactly true.
# It also keeps the test identity on "Ask the copilot" links, so the demo opens as the same person.
ALLOW_TEST_IDENTITIES=
