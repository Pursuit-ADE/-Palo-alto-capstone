# Leave DATABASE_URL empty to use the embedded Postgres (PGlite) in .pglite/
# Set it to use a real Postgres, for example the one in docker-compose.yml.
DATABASE_URL=
# Base URL of the copilot, for "Ask the copilot" links.
COPILOT_URL=http://localhost:3000
# JSON map of user id -> that user's own Slack incoming webhook. Never commit real values.
SLACK_USER_WEBHOOKS=
