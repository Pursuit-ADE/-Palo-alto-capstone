# Database. Leave both empty for the embedded, in-memory database (state resets on restart).
# For a persistent database, run `docker compose up -d` in the repo root, then `npm run db:setup` with
# MIGRATION_DATABASE_URL (the owner login). The running server needs only ALERTS_DATABASE_URL.
MIGRATION_DATABASE_URL=
ALERTS_DATABASE_URL=
# A production server refuses the embedded database unless ALLOW_EMBEDDED_DB=true (the laptop demo).
ALLOW_EMBEDDED_DB=
# Example values for ../docker-compose.yml (local development only):
# MIGRATION_DATABASE_URL=postgres://copilot_owner:local_dev_only@127.0.0.1:5432/alerts
# ALERTS_DATABASE_URL=postgres://alerts_app:alerts_local_dev@127.0.0.1:5432/alerts

# Scheduler. Off: one evaluation as of the demo time. On: a tick every ALERTS_TICK_SECONDS with the real clock.
ALERTS_SCHEDULER=
ALERTS_TICK_SECONDS=60
# Each tick looks this far back again for events imported late (deduplicated). Default 72.
ALERTS_LATE_WINDOW_HOURS=72
# Set to false to start with no subscriptions (people add their own on the page).
ALERTS_SEED_DEMO_SUBSCRIPTIONS=

# Base URL of the copilot, for "Ask the copilot" links.
COPILOT_URL=http://localhost:3000
# JSON map of user id -> that user's own Slack incoming webhook. Never commit real values.
SLACK_USER_WEBHOOKS=
# JSON map of user id -> that user's own email address. Never commit real inboxes.
EMAIL_USER_ADDRESSES=
# Where to POST { to, subject, text, html }. HTTPS on a host listed in EMAIL_WEBHOOK_HOSTS, or http://127.0.0.1 /
# localhost with npm run dev. Redirects are never followed. No auth header is sent; a real provider would need one.
EMAIL_WEBHOOK_URL=
# Comma-separated host names EMAIL_WEBHOOK_URL may use, for example mail.example.com. Empty: no HTTPS host is allowed.
EMAIL_WEBHOOK_HOSTS=
# Employee status, a JSON map of user id -> "active" (client ask, Oct 23). Unset: the check is off. Set: only people listed
# as exactly "active" get alerts or can sign in; "inactive", a typo or a missing person gets neither, and so does a
# malformed value. Demo values are synthetic. A real rollout reads Active Directory or HR instead.
# To try it with everyone active except Sam (Sam's alerts stop and Sam can't sign in):
# EMPLOYEE_STATUS={"u_ts_east":"active","u_ts_west":"inactive","u_darcel_schlecht":"active","u_mgr_melvin_marxen":"active","u_analyst":"active"}
EMPLOYEE_STATUS=

# Local testing only. With nobody signed in, the "Viewing as" identity switch works only when this is exactly true.
# Demo accounts are the normal way in: set the same DEMO_INVITE_SECRET as the copilot, and the copilot's
# `npm run invites` codes work here too. Accounts and sessions are separate per app.
# It also keeps the test identity on "Ask the copilot" links, so the demo opens as the same person.
# `npm run dev` only: a production server (`npm start`) refuses to start with it on.
ALLOW_TEST_IDENTITIES=
DEMO_INVITE_SECRET=
# Optional date after which invite codes stop working, for example 2026-11-10. Use the same value as the copilot.
DEMO_INVITE_EXPIRES=
# In production the session cookie is Secure and HSTS is sent unless set to "false" (see the copilot's .env.example).
COOKIE_SECURE=
ENABLE_HSTS=
# Proxies in front of the app that append to X-Forwarded-For, for the per-address sign-in limit (see the copilot's
# .env.example). Empty or 0: the header is ignored and all callers share one limit.
TRUSTED_PROXY_HOPS=

# Retention for `npm run purge` (whole days, at least 1; default 180).
DELIVERY_RETENTION_DAYS=
